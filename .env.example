# --- Telegram (required) ---------------------------------------------------
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Opinion Open API (https://openapi.opinion.trade) ----------------------
# Optional: public read endpoints work without a key (5 req/s per IP).
# With an API key the limit rises to 15 req/s per consumer.
OPINION_API_KEY=

# --- URLs (production defaults) --------------------------------------------
OPINION_API_BASE_URL=https://openapi.opinion.trade
OPINION_WEB_URL=https://opinion.trade

# --- Referral code (your ref from the OPINION referral program) ------------
REF_CODE=your_ref_code

# --- HTTP client -----------------------------------------------------------
REQUEST_TIMEOUT=15
